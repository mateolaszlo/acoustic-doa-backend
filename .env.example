# Server Gateway Ports
PORT_HTTP=3000
PORT_HTTPS=3443
# Optional: Set to true if Windows Hyper-V reserves port 3443 (EACCES) and you want HTTP-only
# DISABLE_HTTPS=true

# SQLite Database Location
DATABASE_PATH=acoustic_doa.db

# Default Edge Device Provisioning API Key
DEFAULT_DEVICE_API_KEY=esp32-acoustic-doa-secret-key-1

# Server Gateway Ports
PORT_HTTP=3000
PORT_HTTPS=3443
# Optional: Set to true if Windows Hyper-V reserves port 3443 (EACCES) and you want HTTP-only
# DISABLE_HTTPS=true

# SQLite Database Location (defaults to ./app.db when omitted)
DATABASE_PATH=./app.db

# Authentication & Initial Seeding (override before deploying outside localhost)
JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=admin@acoustic-doa.local
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_VIEWER_USER=viewer
DEFAULT_VIEWER_EMAIL=viewer@acoustic-doa.local
DEFAULT_VIEWER_PASSWORD=viewer123

# Security: Allowed browser CORS origins (comma-separated) & Auth rate limiting
# CORS_ORIGINS=http://localhost:5173,https://localhost:3443,https://localhost:8443
AUTH_RATE_LIMIT_MAX=25

# Default Edge Device Provisioning API Key
DEFAULT_DEVICE_API_KEY=esp32-acoustic-doa-secret-key-1

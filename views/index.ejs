<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 40px 20px;
      background: #0f172a;
      color: #f8fafc;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
    }
    .card {
      background: #1e293b;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
      border: 1px solid #334155;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }
    h1 { margin-top: 0; color: #38bdf8; font-size: 28px; }
    h2 { font-size: 18px; color: #94a3b8; margin-top: 0; text-transform: uppercase; letter-spacing: 0.05em; }
    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 13px;
      font-weight: 600;
    }
    .badge-online { background: #065f46; color: #34d399; }
    .badge-offline { background: #7f1d1d; color: #f87171; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .metric { background: #0f172a; padding: 16px; border-radius: 8px; border: 1px solid #334155; }
    .metric-value { font-size: 24px; font-weight: 700; color: #f1f5f9; margin-top: 4px; }
    table { width: 100%; border-collapse: collapse; margin-top: 12px; }
    th, td { text-align: left; padding: 12px; border-bottom: 1px solid #334155; font-size: 14px; }
    th { color: #94a3b8; font-weight: 600; }
    a.btn {
      display: inline-block;
      background: #0284c7;
      color: white;
      padding: 10px 18px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      margin-right: 12px;
      margin-top: 8px;
    }
    a.btn:hover { background: #0369a1; }
    a.btn-secondary { background: #334155; }
    a.btn-secondary:hover { background: #475569; }
    code { background: #0f172a; padding: 2px 6px; border-radius: 4px; color: #38bdf8; font-family: monospace; }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1>🎯 Acoustic DOA Gateway</h1>
        <span class="badge badge-online">STATUS: <%= status.toUpperCase() %></span>
      </div>
      <p style="color: #94a3b8; margin-top: 4px;">
        Dual-gateway REST/SSE server for ESP32 acoustic localization array (Client 1) and Web Radar Visualizer (Client 2).
      </p>

      <div style="margin-top: 20px;">
        <a href="/api/docs" class="btn" target="_blank">📖 OpenAPI / Swagger UI</a>
        <a href="/health" class="btn btn-secondary" target="_blank">🩺 Health Check</a>
        <a href="http://localhost:5173" class="btn btn-secondary" target="_blank">📡 Open Web Radar</a>
      </div>
    </div>

    <div class="grid">
      <div class="metric">
        <div style="color: #94a3b8; font-size: 13px;">SERVER UPTIME</div>
        <div class="metric-value"><%= uptime %> s</div>
      </div>
      <div class="metric">
        <div style="color: #94a3b8; font-size: 13px;">ACTIVE SSE CLIENTS</div>
        <div class="metric-value"><%= sseSubscribers %></div>
      </div>
      <div class="metric">
        <div style="color: #94a3b8; font-size: 13px;">PROVISIONED ARRAYS</div>
        <div class="metric-value"><%= devices.length %></div>
      </div>
    </div>

    <div class="card">
      <h2>Registered Edge Devices (ESP32)</h2>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Status</th>
            <th>Sample Rate</th>
            <th>Clock Status</th>
            <th>Last Seen</th>
          </tr>
        </thead>
        <tbody>
          <% if (devices.length === 0) { %>
            <tr><td colspan="6" style="text-align: center; color: #64748b;">No devices registered</td></tr>
          <% } else { %>
            <% devices.forEach(function(d) { %>
              <tr>
                <td><strong>#<%= d.id %></strong></td>
                <td><%= d.name %></td>
                <td>
                  <span class="badge <%= d.status === 'online' ? 'badge-online' : 'badge-offline' %>">
                    <%= d.status %>
                  </span>
                </td>
                <td><%= d.sample_rate %> Hz</td>
                <td><code><%= d.clock_status %></code></td>
                <td><%= d.last_seen_at ? new Date(d.last_seen_at).toLocaleTimeString() : 'Never' %></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>

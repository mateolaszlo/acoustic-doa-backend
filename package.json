{
  "name": "acoustic-doa-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "High-performance REST API and SSE streaming backend for ESP32 acoustic DOA tracking",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate_esp32.ts"
  },
  "keywords": [
    "esp32",
    "acoustic-doa",
    "gcc-phat",
    "rest-api",
    "sse",
    "sound-localization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "@types/swagger-ui-express": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
